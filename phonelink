#!/usr/bin/env bash
# phonelink — one front-end for Android <-> Linux on Omarchy/Hyprland.
#
# This is glue, not a protocol. The heavy lifting belongs to tools that already
# do it well:
#   KDE Connect  notifications, SMS, clipboard, media keys, file share, find-my-phone
#   scrcpy       screen mirroring, control, virtual displays
#   LocalSend    AirDrop-style transfers to anything on the LAN
#   adb          wireless setup, file moves
#
# What it adds is the part none of them do: a single command that knows which
# device you mean, remembers your wireless endpoint, and fails with the exact
# fix instead of a stack trace.

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/phonelink"
DEVICE_FILE="$STATE_DIR/adb-device"
mkdir -p "$STATE_DIR"

# Resolved through the symlink in ~/.local/bin, so the helpers next to the real
# script are found wherever the checkout lives.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SRC_DIR="$(dirname "$SELF")"
# Overridable so the helper can live elsewhere when packaged separately.
NOTIFY_HELPER="${PHONELINK_NOTIFY_HELPER:-$SRC_DIR/lib/kdeconnect-notify.py}"

PKGS=(kdeconnect scrcpy android-tools)

c_red=$'\033[31m'; c_yel=$'\033[33m'; c_cya=$'\033[36m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
[[ -t 1 ]] || { c_red=; c_yel=; c_cya=; c_dim=; c_off=; }

# Omarchy exports a GUM_* palette derived from whatever theme is active, so
# borrowing it keeps this in step with theme changes instead of pinning one
# theme's hexes. The fallbacks are plain ANSI, for non-Omarchy systems.
ui_accent="${GUM_INPUT_PROMPT_FOREGROUND:-3}"
ui_text="${GUM_INPUT_HEADER_FOREGROUND:-7}"
ui_muted="${GUM_INPUT_PLACEHOLDER_FOREGROUND:-8}"
ui_sel_bg="${GUM_FILTER_SELECTED_BACKGROUND:-238}"
ui_sel_fg="${GUM_FILTER_SELECTED_FOREGROUND:-15}"

# "#rrggbb" -> a truecolour SGR escape. A bare number is treated as a 256-colour
# index, which is what the non-Omarchy fallbacks above are.
sgr() {
  local c="$1"
  if [[ $c == '#'?????? ]]; then
    printf '\033[38;2;%d;%d;%dm' "$((16#${c:1:2}))" "$((16#${c:3:2}))" "$((16#${c:5:2}))"
  else
    printf '\033[38;5;%sm' "$c"
  fi
}

have() { command -v "$1" >/dev/null 2>&1; }

# Launched from the Omarchy menu there is no terminal, so anything written to
# stderr is simply lost. Mirror it to the notification bar instead.
gui() { [[ ! -t 2 ]] && have notify-send; }
note() { gui && notify-send -a phonelink "$1" "$2"; return 0; }

die()  { printf '%serror:%s %s\n' "$c_red" "$c_off" "$*" >&2; note "phonelink failed" "$*"; exit 1; }
info() { printf '%s::%s %s\n' "$c_cya" "$c_off" "$*" >&2; }
warn() { printf '%swarn:%s %s\n' "$c_yel" "$c_off" "$*" >&2; }
ok()   { info "$*"; note "phonelink" "$*"; return 0; }

need() {
  local c missing=()
  for c in "$@"; do have "$c" || missing+=("$c"); done
  (( ${#missing[@]} == 0 )) && return 0
  printf '%smissing:%s %s\n' "$c_red" "$c_off" "${missing[*]}" >&2
  printf 'install everything phonelink uses with:\n\n  omarchy pkg add %s\n\n' "${PKGS[*]}" >&2
  note "phonelink: ${missing[*]} not installed" "Run: omarchy pkg add ${PKGS[*]}"
  exit 1
}

# The Omarchy menu runs actions with no terminal attached, so a subcommand that
# prints or prompts would vanish. Those relaunch themselves in a real terminal.
reexec_tty() {
  [[ -t 1 ]] && return 0
  have omarchy-launch-or-focus-tui || return 0
  exec omarchy-launch-or-focus-tui --app-id=org.omarchy.phonelink \
    "bash -c 'phonelink $*; printf \"\\n[any key to close]\"; read -rsn1'"
}

# Same idea as reexec_tty, but for the reply panel, whose height depends on how
# much conversation there is to show. foot takes the size directly; the window
# rule only floats and centres it, so it does not fight this.
reexec_panel() {
  local rows="$1" q
  [[ -t 1 ]] && return 0
  if have foot; then
    # By path, not by name: PATH may hold a different copy of this script than
    # the one running, and the panel must be the same version as its caller.
    printf -v q '%q' "$SELF"
    exec foot --app-id=org.omarchy.phonelink --window-size-chars="96x$rows" \
      -e bash -c "$q reply; read -rsn1 -t 4"
  fi
  reexec_tty reply
}

# ---------------------------------------------------------------- adb devices

adb_serials() { adb devices 2>/dev/null | awk 'NR>1 && $2=="device" {print $1}'; }

# Echo one usable serial. Prefers a live device; falls back to reconnecting the
# wireless endpoint we last saw, which is the common case after a reboot.
adb_pick() {
  local d=() remembered
  mapfile -t d < <(adb_serials)
  if (( ${#d[@]} == 1 )); then printf '%s\n' "${d[0]}"; return 0; fi
  if (( ${#d[@]} > 1 )); then
    if have fzf && [[ -t 0 ]]; then
      printf '%s\n' "${d[@]}" | fzf --prompt='device> ' --height='~40%' --no-multi
    else
      printf '%s\n' "${d[0]}"
    fi
    return 0
  fi
  if [[ -s $DEVICE_FILE ]]; then
    remembered=$(<"$DEVICE_FILE")
    info "nothing attached — trying remembered $remembered"
    if adb connect "$remembered" 2>&1 | grep -qiE 'connected to'; then
      printf '%s\n' "$remembered"; return 0
    fi
  fi
  return 1
}

require_device() {
  local s
  s=$(adb_pick) || die "no Android device.
  USB:      plug the cable in and accept the debugging prompt
  Wireless: phonelink wifi"
  printf '%s\n' "$s"
}

# ------------------------------------------------------------ kde connect ids

kde_device() { kdeconnect-cli --list-available --id-only 2>/dev/null | head -1; }

require_kde() {
  local d
  need kdeconnect-cli
  d=$(kde_device)
  [[ -n $d ]] || die "no paired, reachable KDE Connect device.
  Pair it with:  phonelink kde
  Both ends must be on the same network."
  printf '%s\n' "$d"
}

# ------------------------------------------------------------------- commands

cmd_status() {
  reexec_tty status
  local ok=1 c
  printf '%sdependencies%s\n' "$c_dim" "$c_off"
  for c in kdeconnect-cli scrcpy adb localsend; do
    if have "$c"; then printf '  %-16s ok\n' "$c"
    else printf '  %-16s %smissing%s\n' "$c" "$c_red" "$c_off"; ok=0; fi
  done

  printf '\n%sKDE Connect%s\n' "$c_dim" "$c_off"
  if have kdeconnect-cli; then
    local avail; avail=$(kdeconnect-cli --list-available 2>/dev/null | grep -v '^0 device' || true)
    if [[ -n $avail ]]; then printf '%s\n' "$avail" | sed 's/^/  /'
    else printf '  no reachable device (paired devices may be offline)\n'; fi
  else
    printf '  not installed\n'
  fi

  printf '\n%sadb / scrcpy%s\n' "$c_dim" "$c_off"
  if have adb; then
    local serials=(); mapfile -t serials < <(adb_serials)
    if (( ${#serials[@]} )); then
      local s
      for s in "${serials[@]}"; do
        local model batt
        model=$(adb -s "$s" shell getprop ro.product.model 2>/dev/null | tr -d '\r' || true)
        batt=$(adb -s "$s" shell dumpsys battery 2>/dev/null | awk -F': ' '/ level/{print $2; exit}' | tr -d '\r' || true)
        printf '  %-24s %s%s\n' "$s" "${model:-unknown}" "${batt:+  ${batt}%}"
      done
    else
      printf '  no device attached\n'
      [[ -s $DEVICE_FILE ]] && printf '  remembered wireless endpoint: %s\n' "$(<"$DEVICE_FILE")"
    fi
  else
    printf '  not installed\n'
  fi
  (( ok )) || { printf '\ninstall the missing pieces:\n  omarchy pkg add %s\n' "${PKGS[*]}"; return 1; }
}

cmd_mirror() {
  need scrcpy adb
  local serial extra=()
  serial=$(require_device)
  read -r -a extra <<<"${PHONELINK_SCRCPY_ARGS:---stay-awake}"
  info "mirroring $serial"
  exec scrcpy -s "$serial" --window-title="Phone" "${extra[@]}" "$@"
}

# A virtual display is the reason to bother with scrcpy at all: the app gets its
# own screen at desktop proportions, and the phone stays usable in your hand.
cmd_desk() {
  need scrcpy adb
  local serial size app args=()
  serial=$(require_device)
  size="${PHONELINK_DISPLAY_SIZE:-1600x900/220}"
  app="${1-}"
  if [[ -z $app ]] && have fzf && [[ -t 0 ]]; then
    app=$(list_apps "$serial" | fzf --prompt='app (empty = plain display)> ' --height='~60%' --no-multi | awk '{print $NF}' || true)
  fi
  args=(-s "$serial" --new-display="$size" --window-title="Phone desk")
  [[ -n $app ]] && args+=(--start-app="$app")
  info "new virtual display $size${app:+, launching $app}"
  exec scrcpy "${args[@]}"
}

list_apps() {
  local serial="$1"
  scrcpy -s "$serial" --list-apps 2>/dev/null | sed -n 's/^ *[*-] *//p' | grep . && return 0
  adb -s "$serial" shell pm list packages -3 2>/dev/null | tr -d '\r' | sed 's/^package://' | sort
}

cmd_apps() { reexec_tty apps; need scrcpy adb; list_apps "$(require_device)"; }

cmd_wifi() {
  reexec_tty wifi
  need adb
  adb start-server >/dev/null 2>&1 || true

  local existing usb ip
  existing=$(adb_serials | grep -m1 ':' || true)
  if [[ -n $existing ]]; then
    printf '%s\n' "$existing" > "$DEVICE_FILE"
    info "already wireless: $existing"
    return 0
  fi

  # A cable, if present, is the painless route: no pairing code needed.
  usb=$(adb_serials | grep -m1 -v ':' || true)
  if [[ -n $usb ]]; then
    info "found $usb over USB — switching it to wireless"
    ip=$(adb -s "$usb" shell ip route 2>/dev/null | tr -d '\r' | awk '/wlan[0-9]/ && /src/ {for(i=1;i<=NF;i++) if($i=="src") print $(i+1); exit}')
    [[ -n $ip ]] || ip=$(adb -s "$usb" shell ip -4 addr show wlan0 2>/dev/null | tr -d '\r' | awk '/inet /{sub(/\/.*/,"",$2); print $2; exit}')
    [[ -n $ip ]] || die "could not read the phone's Wi-Fi address — is Wi-Fi on?"
    adb -s "$usb" tcpip 5555 >/dev/null
    sleep 2
    adb connect "$ip:5555" | sed 's/^/  /'
    printf '%s\n' "$ip:5555" > "$DEVICE_FILE"
    info "remembered $ip:5555 — you can unplug the cable now"
    return 0
  fi

  warn "no device over USB; falling back to wireless debugging (needs a one-time pair)"
  cmd_pair
}

cmd_pair() {
  reexec_tty pair
  need adb
  [[ -t 0 ]] || die "pairing is interactive — run 'phonelink pair' in a terminal"
  cat >&2 <<'EOS'

On the phone:
  Settings -> System -> Developer options -> Wireless debugging   (turn ON)
  then tap "Pair device with pairing code"

Leave that dialog open. It shows an IP:PORT and a 6-digit code.

EOS
  local addr code conn found yn
  found=$(adb mdns services 2>/dev/null | awk '/_adb-tls-pairing/ {print $NF; exit}' || true)
  if [[ -n $found ]]; then
    read -rp "found a pairing endpoint at $found — use it? [Y/n] " yn
    [[ ${yn,,} == n* ]] || addr=$found
  fi
  [[ -n ${addr:-} ]] || read -rp "pairing IP:PORT (from the dialog): " addr
  [[ -n ${addr:-} ]] || die "no address given"
  read -rp "6-digit pairing code: " code
  adb pair "$addr" "$code" || die "pairing failed — the code expires fast, try again"

  # The connect port is NOT the pairing port. This trips up everyone.
  conn=$(adb mdns services 2>/dev/null | awk '/_adb-tls-connect/ {print $NF; exit}' || true)
  [[ -n $conn ]] || read -rp "connect IP:PORT (shown on the Wireless debugging screen): " conn
  adb connect "$conn" | sed 's/^/  /'
  printf '%s\n' "$conn" > "$DEVICE_FILE"
  info "remembered $conn"
}

cmd_send() {
  local dev f files=()
  if (( $# )); then
    files=("$@")
  elif have omarchy-file-select; then
    mapfile -t files < <(omarchy-file-select --title "Send to phone" --multiple)
    (( ${#files[@]} )) || return 0   # chooser cancelled
  else
    die "usage: phonelink send <file> [file...]"
  fi
  dev=$(require_kde)
  local sent=0
  for f in "${files[@]}"; do
    [[ -e $f ]] || { warn "skipping missing $f"; continue; }
    kdeconnect-cli -d "$dev" --share "$(realpath "$f")" && (( ++sent ))
  done
  (( sent )) && ok "sent $sent file(s) to the phone"
}

cmd_ring() { kdeconnect-cli -d "$(require_kde)" --ring && ok "ringing your phone"; }

# Android attaches a RemoteInput action to any notification you could answer
# from the phone's own shade -- messengers and SMS, not news feeds. KDE Connect
# carries that through as a replyId, and sendReply() puts the answer back into
# the originating app. See lib/kdeconnect-notify.py for the D-Bus side.
cmd_reply() {
  local direct=0
  [[ ${1-} == --list ]] && { need_reply_deps; "$NOTIFY_HELPER" list | jq -r \
    '.[] | "\(.app) — \(.title): \((.thread | last | .body) // .text)"'; return 0; }
  (( $# )) && direct=1
  need_reply_deps

  # Fetched before opening a terminal, not after: the panel is sized from what
  # is actually waiting, and "nothing to reply to" needs no window at all.
  local json count
  json=$("$NOTIFY_HELPER" list) || die "could not reach kdeconnectd. Is KDE Connect running?"
  count=$(printf '%s' "$json" | jq 'length')

  (( count )) || die "nothing to reply to right now.
  Only notifications you could answer from the phone's own shade show up here --
  messengers and SMS. Feed and news apps offer no reply box, so KDE Connect has
  nothing to send to."

  # Only a prompt needs a terminal; `phonelink reply "text"` does not.
  (( direct )) || reexec_panel "$(panel_rows "$json" "$count")"

  local path msg
  if (( direct )) || (( count == 1 )); then
    # With text on the command line this is the instant-reply path: newest wins,
    # no picker, so it can sit on a keybind.
    path=$(printf '%s' "$json" | jq -r '.[0].path')
  else
    local pick
    pick=$(printf '%s' "$json" | jq -r '.[] | "\(.path)\t\(.title)  ·  \((.thread | last | .body) // .text)"' \
      | fzf --delimiter='\t' --with-nth=2.. --no-multi --height='~100%' \
            --border=rounded --border-label=' waiting ' --padding='0,1' \
            --prompt='  󰍉  ' --pointer='❯' --marker='❯' \
            --color="fg:$ui_text,hl:$ui_accent,fg+:$ui_sel_fg,bg+:$ui_sel_bg,hl+:$ui_accent,prompt:$ui_accent,pointer:$ui_accent,border:$ui_muted,label:$ui_muted,info:$ui_muted") || return 0
    path=${pick%%$'\t'*}
  fi

  # Read the chosen conversation back out of the JSON rather than scraping the
  # picker line: with one message pending there is no picker at all, and the
  # message still has to be on screen while you answer it.
  local app title text ticker label body thread
  eval "$(printf '%s' "$json" | jq -r --arg p "$path" '.[] | select(.path==$p) |
    "app=\(.app|@sh) title=\(.title|@sh) text=\(.text|@sh) ticker=\(.ticker//""|@sh)"')"
  thread=$(printf '%s' "$json" | jq -c --arg p "$path" '.[] | select(.path==$p) | .thread // []')
  label="$app — $title"
  body="$text"
  [[ -n ${body//[[:space:]]/} ]] || body="$ticker"

  if (( direct )); then
    msg="$*"
  else
    show_incoming "$title" "$app" "$thread" "$body"
    if have gum; then
      # gum picks the prompt/cursor/placeholder colours out of the GUM_INPUT_*
      # environment Omarchy sets, so it is already themed.
      msg=$(gum input --prompt "  ❯ " --placeholder "reply to $title…" --width 70) || return 0
    else
      read -rp "  reply: " msg
    fi
  fi
  [[ -n ${msg//[[:space:]]/} ]] || { warn "empty reply, nothing sent"; return 0; }

  "$NOTIFY_HELPER" send "$path" "$msg"
  ok "replied to $label"
}

# Render the conversation the way a messaging app would: who spoke, then what
# they said. Android packs a group thread into one notification body as
# "<b>Name</b><br/>text<br/>..." -- shown raw that is a wall of markup, so the
# helper parses it and this lays it out. A repeated speaker is not re-labelled.
show_incoming() {
  local who="$1" app="${2:-}" thread="${3:-[]}" fallback="${4:-}"
  local acc mut txt off width total limit skip prev sender body line
  acc=$(sgr "$ui_accent"); mut=$(sgr "$ui_muted"); txt=$(sgr "$ui_text"); off=$'\033[0m'

  width=$(( ${COLUMNS:-$(tput cols 2>/dev/null || echo 90)} - 6 ))
  (( width > 96 )) && width=96
  (( width < 30 )) && width=30

  printf '\n  %s󰭹  %s%s   %s·   %s%s\n\n' "$acc" "$who" "$off" "$mut" "$app" "$off"

  total=$(printf '%s' "$thread" | jq 'length' 2>/dev/null || echo 0)
  if (( total == 0 )); then
    printf '  %s%s%s\n\n' "$txt" "${fallback:-(no preview text — check the phone)}" "$off"
    return 0
  fi

  # Only the tail is worth showing; the rest is history you already have.
  limit="${PHONELINK_THREAD_LINES:-6}"
  skip=0
  (( total > limit )) && skip=$(( total - limit ))
  (( skip )) && printf '  %s… %d earlier%s\n\n' "$mut" "$skip" "$off"

  prev=""
  # Split on US, not tab: bash treats tab as IFS whitespace and swallows a
  # leading empty field, so a message with no sender -- every one-to-one chat --
  # would put the body into `sender` and paint it as a name.
  while IFS=$'\x1f' read -r sender body; do
    if [[ -n $sender && $sender != "$prev" ]]; then
      printf '  %s%s%s\n' "$acc" "$sender" "$off"
    fi
    prev="$sender"
    while IFS= read -r line; do
      printf '  %s%s%s\n' "$txt" "$line" "$off"
    done < <(printf '%s\n' "$body" | fold -s -w "$width")
    printf '\n'
  done < <(printf '%s' "$thread" | jq -r --argjson s "$skip" '.[$s:][] | "\(.sender)\(.body)"')
}

# Height the panel to the message before opening it: a fixed size either clips a
# group thread or leaves a one-line chat mostly empty.
panel_rows() {
  local json="$1" count="$2" limit="${PHONELINK_THREAD_LINES:-6}" rows n
  if (( count > 1 )); then
    rows=$(( count + 7 ))          # picker: a row each, plus border and prompt
  else
    # Measured, not guessed: a long message wraps and a short one does not, and
    # under-counting scrolls the header off the top of the panel.
    n=$(printf '%s' "$json" | jq --argjson lim "$limit" '
      (.[0].thread // []) as $t
      | (if ($t | length) > $lim then $t[($t | length) - $lim:] else $t end)
      | if length == 0 then 3
        else [ .[] | 2 + ((((.body | length) - 1) / 90) | floor) + 1 ] | add
        end')
    rows=$(( 6 + n ))              # header, blank, prompt, help, margins
  fi
  (( rows < 10 )) && rows=10
  (( rows > 40 )) && rows=40
  printf '%s\n' "$rows"
}

need_reply_deps() {
  need kdeconnect-cli
  have jq || die "phonelink reply needs jq (it ships with Omarchy: omarchy pkg add jq)"
  [[ -x $NOTIFY_HELPER ]] || die "reply helper missing at $NOTIFY_HELPER"
}

cmd_clip() {
  local dev; dev=$(require_kde)
  kdeconnect-cli -d "$dev" --send-clipboard 2>/dev/null && { ok "clipboard pushed"; return 0; }
  have wl-paste || die "this kdeconnect has no --send-clipboard and wl-clipboard is not installed"
  kdeconnect-cli -d "$dev" --share-text "$(wl-paste)" && ok "clipboard pushed as text"
}

cmd_pull() {
  need adb
  (( $# )) || die "usage: phonelink pull <path-on-phone> [local-dest]"
  local serial; serial=$(require_device)
  adb -s "$serial" pull "$1" "${2:-$PWD}"
}

cmd_push() {
  need adb
  (( $# )) || die "usage: phonelink push <local-file> [path-on-phone]"
  local serial; serial=$(require_device)
  adb -s "$serial" push "$1" "${2:-/sdcard/Download/}"
}

launch() { if have uwsm-app; then uwsm-app -- "$@"; else "$@"; fi; }

cmd_kde()  { need kdeconnect-app; launch kdeconnect-app; }
cmd_sms()  { need kdeconnect-sms; launch kdeconnect-sms; }
cmd_drop() { need localsend; launch localsend; }

cmd_menu() {
  reexec_tty menu
  have fzf || die "the menu needs fzf"
  local choice
  choice=$(printf '%s\n' \
    'status   what is connected right now' \
    'reply    reply to a phone notification from here' \
    'mirror   mirror and control the phone screen' \
    'desk     run one app on its own virtual display' \
    'send     share a file to the phone' \
    'drop     LocalSend (send to anything on the LAN)' \
    'ring     find my phone' \
    'clip     push clipboard to the phone' \
    'wifi     set up or reconnect wireless adb' \
    'kde      open KDE Connect (pairing, SMS, settings)' \
    | fzf --prompt='phonelink> ' --height='~50%' --no-multi) || return 0
  main "${choice%% *}"
}

cmd_help() {
  cat <<'EOS'
phonelink — Android on your Linux desktop

  status            what is connected right now, and what is missing
  mirror [args...]  mirror and control the phone screen (extra args go to scrcpy)
  desk [package]    run one app on its own virtual display; picks with fzf if omitted
  apps              list launchable app packages
  wifi              switch to / reconnect wireless adb, and remember it
  pair              Android 11+ wireless-debugging pairing walkthrough
  send <files...>   share files to the phone via KDE Connect
  pull <remote> [d] copy a file off the phone
  push <local> [d]  copy a file onto the phone
  reply [text]      reply to a phone notification without touching the phone.
                    With no text: pick a conversation and type. With text:
                    straight to the newest one, so it can sit on a keybind.
  reply --list      show which notifications can be replied to
  ring              make the phone ring
  clip              push the desktop clipboard to the phone
  kde               open KDE Connect (pairing, SMS, notification settings)
  sms               open the KDE Connect SMS window
  drop              open LocalSend
  menu              fzf picker for all of the above

Environment:
  PHONELINK_SCRCPY_ARGS    default scrcpy args for `mirror`  (default: --stay-awake)
  PHONELINK_DISPLAY_SIZE   virtual display for `desk`        (default: 1600x900/220)
EOS
}

main() {
  case "${1-menu}" in
    status)        shift; cmd_status "$@" ;;
    mirror|mir)    shift; cmd_mirror "$@" ;;
    desk|display)  shift; cmd_desk "$@" ;;
    apps)          shift; cmd_apps "$@" ;;
    wifi|wireless) shift; cmd_wifi "$@" ;;
    pair)          shift; cmd_pair "$@" ;;
    send|share)    shift; cmd_send "$@" ;;
    pull)          shift; cmd_pull "$@" ;;
    push)          shift; cmd_push "$@" ;;
    ring|find)     shift; cmd_ring "$@" ;;
    reply|r)       shift; cmd_reply "$@" ;;
    clip|clipboard) shift; cmd_clip "$@" ;;
    kde)           shift; cmd_kde "$@" ;;
    sms)           shift; cmd_sms "$@" ;;
    drop|localsend) shift; cmd_drop "$@" ;;
    menu)          shift; cmd_menu "$@" ;;
    -h|--help|help) cmd_help ;;
    *) die "unknown command: $1  (try: phonelink --help)" ;;
  esac
}

main "$@"
