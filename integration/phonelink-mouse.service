[Unit]
Description=phonelink mouse sharing: push the pointer past a screen edge to drive the phone
Documentation=https://github.com/blazghost/phonelink
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Through the PATH symlink install.sh makes, so it follows the checkout.
ExecStart=%h/.local/bin/phonelink mouse-daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
