# >>> phonelink toasts
# Phone notifications and calls are drawn by phonelink's own toasts, so KDE
# Connect's plain popups for them would be duplicates. Only these events are
# silenced: pairing requests, pings and low battery keep their popups.
# `phonelink toasts off` removes this block.
[Event/notification]
Action=

[Event/callReceived]
Action=

[Event/missedCall]
Action=
# <<< phonelink toasts
