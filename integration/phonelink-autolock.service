[Unit]
Description=phonelink autolock: lock the desktop when the phone walks away
Documentation=https://github.com/blazghost/phonelink
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Through the PATH symlink install.sh makes, so it follows the checkout.
ExecStart=%h/.local/bin/phonelink autolock-daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
