-- phonelink:photos:begin v1
-- phonelink:photos -- the Photos window is a grid of the phone's camera roll,
-- and Omarchy's default translucency lets the desktop show through every
-- picture in it.
o.window("^(org\\.omarchy\\.phonelink\\.photos)$", { tag = "-default-opacity", opacity = "1 1" })
-- phonelink:photos:end
