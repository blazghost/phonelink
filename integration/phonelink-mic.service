[Unit]
Description=phonelink mic: "Phone microphone", switched on by whatever records from it
Documentation=https://github.com/blazghost/phonelink
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Through the PATH symlink install.sh makes, so it follows the checkout.
ExecStart=%h/.local/bin/phonelink mic-daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
