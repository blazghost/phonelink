
-- phonelink / scrcpy: a phone mirror is video. Omarchy's default translucency
-- and backdrop blur wreck it, and the screen should not idle-lock while you're
-- actually using the phone through it.
o.window("^([sS]crcpy)$", {
  tag = "-default-opacity",
  opacity = "1 1",
  no_blur = true,
  idle_inhibit = "focus",
})

-- The handheld mirror is a tall utility window, so float it. The virtual
-- "desk" display is desktop-shaped and tiles like any other window.
o.window({ class = "^([sS]crcpy)$", title = "^Phone$" }, { float = true, center = true })
