[Unit]
Description=phonelink webcam: "Phone camera", switched on by whatever opens it
Documentation=https://github.com/blazghost/phonelink
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Through the PATH symlink install.sh makes, so it follows the checkout.
ExecStart=%h/.local/bin/phonelink webcam-daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
